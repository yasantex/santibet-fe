# Base URL of the API. Every request path is appended to this, so it MUST
# include the `/api` prefix the backend serves under (e.g. `/auth/me` becomes
# `<BASE>/auth/me` → `.../api/auth/me`).
#
# Production (Netlify etc.): use the absolute URL — there is no proxy.
#   VITE_APP_API_BASE_URL=https://santibet-8b7dfea9557d.herokuapp.com/api
#
# Local dev: prefer the relative `/api` so requests go through the vite proxy
# (see vite.config.ts), which forwards to Heroku and avoids CORS:
#   VITE_APP_API_BASE_URL=/api
VITE_APP_API_BASE_URL=https://santibet-8b7dfea9557d.herokuapp.com/api

# Google OAuth client ID used by src/utils/googleAuth.ts
VITE_APP_GOOGLE_CLIENT_ID=
