# Base URL of the API. Every request path is appended to this, so it MUST
# include the `/api` prefix the backend serves under (e.g. `/auth/me` becomes
# `<BASE>/auth/me` → `.../api/auth/me`).
#
# Production (Netlify etc.): use the absolute URL — there is no proxy.
#   VITE_APP_API_BASE_URL=https://api.santibet.com/api
#
# Local dev: prefer the relative `/api` so requests go through the vite proxy
# (see vite.config.ts), which forwards to the API and avoids CORS:
#   VITE_APP_API_BASE_URL=/api
VITE_APP_API_BASE_URL=https://api.santibet.com/api

# Google OAuth client ID used by src/utils/googleAuth.ts
VITE_APP_GOOGLE_CLIENT_ID=

# FALLBACK ONLY. The Kudipal checkout link is normally returned by the backend
# as `checkoutUrl` on the deposit-create response (reference + amount already
# appended), so it can be rotated without a frontend deploy. This base link is
# used only if that field is missing; the deposit flow then appends
# `?reference=<deposit reference>&amount=<naira>` itself.
VITE_APP_KUDIPAL_PAYMENT_LINK=https://pay.kudipal.co/6aab00b80d7c110022360b2f

# ── Chatwoot live chat (customer support) ─────────────────────────────────
# Both are PUBLIC values (they ship in the browser bundle) — from Chatwoot:
#   Settings → Inboxes → <Website inbox> → Configuration → widget script.
# Leave either blank to disable live chat entirely (launcher hidden; "Contact
# support" falls back to /contact-us). The inbox HMAC token is a SECRET and
# lives ONLY on the backend (CHATWOOT_INBOX_HMAC_TOKEN) — never put it here.
#
# Base URL of the Chatwoot install, no trailing slash
# (Chatwoot Cloud: https://app.chatwoot.com, self-hosted: https://support.santibet.com)
VITE_APP_CHATWOOT_BASE_URL=
# The website inbox's `websiteToken`
VITE_APP_CHATWOOT_WEBSITE_TOKEN=
